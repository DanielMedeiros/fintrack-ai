{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "db:generate": { "cache": false },
    "build": { "dependsOn": ["^db:generate", "^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^db:generate", "^typecheck"] }
  }
}
